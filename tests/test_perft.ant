# Checks move generation against known perft counts (the same positions the
# chess programming community uses, and that the C++ engine's perft agrees on).
# Run: antares tests/test_perft.ant

use "../src/board"

to expect(name, fen, depth, want) {
    set_fen(fen)
    before = hash
    started = clock()
    got = perft(depth, 0)
    took = clock() - started
    when got == want {
        show "ok   {name} depth {depth}: {got}  ({round(got / took)} positions/s)"
    } else {
        show "FAIL {name} depth {depth}: got {got}, expected {want}"
    }
    check(hash == before, "{name}: the position key changed after perft")
    got == want
}

good = yes
good = expect("start position", START_FEN, 1, 20) and good
good = expect("start position", START_FEN, 2, 400) and good
good = expect("start position", START_FEN, 3, 8902) and good
good = expect("kiwipete", "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1", 1, 48) and good
good = expect("kiwipete", "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1", 2, 2039) and good
good = expect("kiwipete", "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1", 3, 97862) and good
good = expect("endgame", "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1", 3, 2812) and good
good = expect("endgame", "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1", 4, 43238) and good
good = expect("promotions", "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1", 3, 9467) and good
good = expect("position 5", "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8", 3, 62379) and good
good = expect("position 6", "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10", 2, 2079) and good

when good { show "all perft counts match" } else { fail("perft mismatch") }
